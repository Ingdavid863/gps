<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/search_panel"
            android:elevation="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/menuButton"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="☰"
                android:textColor="#27313A"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="¿A dónde vas?"
                android:imeOptions="actionSearch"
                android:inputType="textPostalAddress"
                android:singleLine="true"
                android:textColor="#17212B"
                android:textColorHint="#6E7882"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/searchButton"
                android:layout_width="50dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="Ir"
                android:textColor="#1469D8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bottom_panel"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bottom_panel"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajustes de navegación"
                android:textColor="#17212B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings3d"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="Vista 3D: activada"
                android:textColor="#27313A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settingsVoice"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="Voz: activada"
                android:textColor="#27313A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settingsAutoZoom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="Zoom automático según velocidad: activado"
                android:textColor="#27313A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settingsFollowDelay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="Retomar seguimiento después de zoom: 8 s"
                android:textColor="#27313A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settingsClose"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical|end"
                android:text="Cerrar"
                android:textColor="#1469D8"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/gpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="@drawable/nav_banner"
            android:elevation="5dp"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="GPS · esperando señal"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/turnBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/nav_banner"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:minHeight="78dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/turnIcon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:gravity="center"
                android:text="↑"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="Busca un destino o mantén pulsado el mapa"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/turnDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="GPS3D · navegación de alta precisión"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/routeChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recenterButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/floating_button"
            android:elevation="8dp"
            android:gravity="center"
            android:text="◎"
            android:textColor="#1B2733"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/floating_button"
            android:elevation="8dp"
            android:gravity="center"
            android:text="3D"
            android:textColor="#1B2733"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/floating_button"
            android:elevation="8dp"
            android:gravity="center"
            android:text="🔊"
            android:textColor="#1B2733"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/reportButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/floating_button"
            android:elevation="8dp"
            android:gravity="center"
            android:text="⚠"
            android:textColor="#D85319"
            android:textSize="23sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/speedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#202124"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#6A6D70"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="12dp"
                android:background="#22000000" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/etaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin ruta activa"
                    android:textColor="#16834B"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/routeDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Selecciona un destino para comenzar"
                    android:textColor="#3C4043"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/arrivalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text=""
                    android:textColor="#74777A"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/stopButton"
                android:layout_width="58dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#C8342F"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="8dp"
            android:background="#22000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/signalDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚦 Próximo: --"
                android:textColor="#303134"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/signalPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="DEMO"
                android:textColor="#B06B00"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/signalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="-- s"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
